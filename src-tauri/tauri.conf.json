{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri Endless Runner",
  "version": "0.1.0",
  "identifier": "com.example.tauriendlessrunner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "持续前进 · Tauri Runner",
        "width": 560,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}